{
  "root": true,
  "extends": ["expo", "prettier"],
  "ignorePatterns": ["/dist/*"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["*.config.js", "babel.config.js", "metro.config.js", "tailwind.config.js"],
      "env": { "node": true, "commonjs": true }
    }
  ]
}
